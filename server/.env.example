# Civics Interview API — copy to .env and adjust as needed.

# LLM backend (local Ollama via llm_core)
OLLAMA_HOST=http://localhost:11434
GRADER_PROVIDER=ollama
GRADER_MODEL=qwen3.5:9b
GRADE_TIMEOUT=30
GRADE_MAX_TOKENS=400

# CORS: the site origin(s), comma-separated. Add your public domain for deploy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Abuse guard
RATE_LIMIT_PER_MIN=30
MAX_TRANSCRIPT_CHARS=600

# TTS (Phase 3) — Piper
PIPER_BIN=piper
PIPER_VOICE=

# STT (Phase 3) — faster-whisper
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

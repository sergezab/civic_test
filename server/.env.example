# Civics Interview API — copy to .env and adjust as needed.

# Backend port (read by bin/civicctl.sh). Defaults to 8090.
# Change it here to move the API for all civicctl runs in this repo.
CIVIC_BACKEND_PORT=8090

# Frontend TLS for civicctl. Set to 1 on a LAN host used by iPads/remote Macs;
# mic access needs HTTPS outside localhost. Plain `restart` also preserves an
# already-HTTPS frontend unless you pass `--http`.
CIVIC_UI_HTTPS=0

# LLM backend. GRADER_PROVIDER picks the path:
#   ollama → local Ollama /api/chat (default)
#   mlx    → local MLX server (OpenAI-compatible /v1/chat/completions, see below)
#   gemini/gpt/claude/… → shared llm_core (cloud)
# Examples:
#   This Mac (native Ollama):   http://localhost:11434       + qwen3.5:9b
#   Mac Studio (fast 35B MoE):  http://macstudio.lan:11434   + qwen3.6:35b-a3b-mlx-bf16
OLLAMA_HOST=http://localhost:11434
GRADER_PROVIDER=ollama
GRADER_MODEL=qwen3.5:9b
GRADE_TIMEOUT=45
GRADE_MAX_TOKENS=300
GRADE_TEMPERATURE=0.2

# Local MLX server (only used when GRADER_PROVIDER=mlx). Default 8088 matches the
# com.astra.mlx-vlm LaunchAgent; MLX_API_KEY is optional (secured tunnels only).
MLX_BASE_URL=http://localhost:8088
MLX_API_KEY=

# CORS: the site origin(s), comma-separated. Add your public domain for deploy.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Abuse guard (request caps)
RATE_LIMIT_PER_MIN=30
MAX_TRANSCRIPT_CHARS=600
MAX_ACCEPTED_ANSWERS=40
MAX_AUDIO_BYTES=12582912         # 12 MiB cap on uploaded /stt audio
TRUST_PROXY_HEADERS=0
GRADE_CONCURRENCY=1
TTS_CONCURRENCY=1
STT_CONCURRENCY=1
LLM_GUARD_ENABLED=1             # local prompt-injection scanner (llm-guard)
LLM_GUARD_THRESHOLD=0.92

# Logging
LOG_LEVEL=INFO

# TTS — Piper (preferred) with macOS `say` fallback
TTS_ENGINE=piper                 # piper | say | auto
TTS_TIMEOUT=30
PIPER_VOICE=                     # blank = bundled voices/en_US-lessac-medium.onnx

# STT — faster-whisper
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

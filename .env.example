# Frontend build-time config. Copy to `.env.local` (dev) or set in your host's
# build env (production). Vite only exposes vars prefixed with VITE_.

# OPTIONAL. By default the app calls the interview API at a relative path, routed
# through the Vite dev proxy (or a same-origin reverse proxy in production) — no
# CORS, no mixed content. Only set this to call the backend DIRECTLY (e.g. a
# Cloudflare Tunnel URL), and add that origin to the backend's ALLOWED_ORIGINS.
# VITE_INTERVIEW_API_URL=https://your-tunnel.trycloudflare.com

# Dev-only knobs (env at `npm run dev` time, not VITE_-prefixed):
#   HTTPS=1        → serve the dev server over HTTPS (needed for mic over the LAN); `npm run dev:https`
#   API_PROXY=...  → proxy target for the API (default from CIVIC_BACKEND_PORT
#                   or server/.env, falling back to http://localhost:8090)

# Frontend build-time config. Copy to `.env.local` (dev) or set in your host's
# build env (production). Vite only exposes vars prefixed with VITE_.

# URL of the interview backend (FastAPI). Defaults to the local dev server when
# unset. In production, set this to your Cloudflare Tunnel / public API URL.
VITE_INTERVIEW_API_URL=http://localhost:8088

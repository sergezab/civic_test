# Logs
logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build output
node_modules
dist
dist-ssr
*.local
coverage

# Python (backend)
**/__pycache__/
*.py[cod]
.venv/
**/.venv/

# Env / secrets — keep the *.example templates, ignore real env files
.env
.env.*
!.env.example
!server/.env.example

# Large / generated artifacts (re-creatable)
#   server/voices: Piper voice model — re-download with `python -m piper.download_voices`
#   .audio-tmp: scratch dir used by scripts/generate-audio.mjs
#   NOTE: public/audio/*.m4a IS committed (static content; regenerate via npm run gen:audio)
server/voices/
.audio-tmp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test output
/playwright-report/
/test-results/
.playwright-mcp/

# Python (server backend + pytest)
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
